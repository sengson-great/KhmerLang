    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Khmer CLI (khmer.dart)",
            "cwd": "cli",
            "request": "launch",
            "type": "dart",
            "program": "cli/bin/khmer.dart"
        },
        {
            "name": "khmer_ide (Flutter)",
            "cwd": "ide/khmer_ide",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "khmer_ide (profile mode)",
            "cwd": "ide/khmer_ide",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "khmer_ide (release mode)",
            "cwd": "ide/khmer_ide",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}