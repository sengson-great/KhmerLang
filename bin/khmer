#!/usr/bin/env python3
import sys
import os

# Add parent directory of real file to python path (resolves symlinks)
real_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.abspath(os.path.join(real_dir, '..')))

from khmer_lang.cli import main

if __name__ == "__main__":
    main()
