# ឧទាហរណ៍ 6: ការសរសេរប្រូក្រាមតាមបែប OOP (Object-Oriented Programming)

ថ្នាក់ មនុស្ស {
    បង្កើត(ឈ្មោះ, អាយុ) {
        នេះ.ឈ្មោះ = ឈ្មោះ
        នេះ.អាយុ = អាយុ
    }

    អនុគមន៍ ណែនាំខ្លួន() {
        បង្ហាញ("ជម្រាបសួរ! ខ្ញុំឈ្មោះ", នេះ.ឈ្មោះ, "អាយុ", នេះ.អាយុ, "ឆ្នាំ")
    }

    អនុគមន៍ ខួបកំណើត() {
        នេះ.អាយុ = នេះ.អាយុ + ១
        បង្ហាញ(នេះ.ឈ្មោះ, "អាយុឡើងដល់:", នេះ.អាយុ, "ឆ្នាំ")
    }
}

# ថ្នាក់ សិស្ស បន្តពី ថ្នាក់ មនុស្ស (Inheritance)
ថ្នាក់ សិស្ស បន្តពី មនុស្ស {
    បង្កើត(ឈ្មោះ, អាយុ, សាលា) {
        នេះ.ឈ្មោះ = ឈ្មោះ
        នេះ.អាយុ = អាយុ
        នេះ.សាលា = សាលា
    }

    អនុគមន៍ បង្ហាញព័ត៌មានសិស្ស() {
        បង្ហាញ("សិស្សឈ្មោះ:", នេះ.ឈ្មោះ, "រៀននៅ:", នេះ.សាលា)
    }
}

បង្ហាញ("--- ការបង្កើត Object មនុស្ស ---")
តាំង មនុស្ស១ = ថ្មី មនុស្ស("វ៉េងឈួង", ២១)
មនុស្ស១.ណែនាំខ្លួន()
មនុស្ស១.ខួបកំណើត()

បង្ហាញ("--- ការបង្កើត Object សិស្ស (Inheritance) ---")
តាំង សិស្ស១ = ថ្មី សិស្ស("ដារ៉ា", ១៨, "វិទ្យាល័យសិស្សពូកែ")
សិស្ស១.ណែនាំខ្លួន()
សិស្ស១.បង្ហាញព័ត៌មានសិស្ស()

# ថ្នាក់ គណនីធនាគារ បង្ហាញពី Getter និង Setter (យក និង ដាក់ / កំណត់)
ថ្នាក់ គណនីធនាគារ {
    បង្កើត(ម្ចាស់, ប្រាក់ដំបូង) {
        នេះ.ម្ចាស់ = ម្ចាស់
        នេះ._ប្រាក់ = ប្រាក់ដំបូង
    }

    # Getter: យក
    យក សមតុល្យ {
        ត្រឡប់ នេះ._ប្រាក់
    }

    # Setter: ដាក់
    ដាក់ សមតុល្យ(ចំនួន) {
        បើ (ចំនួន < ០) {
            បង្ហាញ("កំហុស៖ ចំនួនប្រាក់មិនអាចអវិជ្ជមានបានទេ!")
        } ផ្សេងទៀត {
            នេះ._ប្រាក់ = ចំនួន
        }
    }
}

បង្ហាញ("--- ការប្រើប្រាស់ Getter និង Setter (យក និង ដាក់) ---")
តាំង គណនី១ = ថ្មី គណនីធនាគារ("វ៉េងឈួង", ៥០០)
បង្ហាញ("សមតុល្យបច្ចុប្បន្ន:", គណនី១.សមតុល្យ)

# ហៅ Setter ដោយការកំណត់តម្លៃផ្ទាល់
គណនី១.សមតុល្យ = ១២០០
បង្ហាញ("សមតុល្យក្រោយកែប្រែ:", គណនី១.សមតុល្យ)

