# ឧទាហរណ៍ 3: លក្ខខណ្ឌ និងរង្វិលជុំ (Control Flow & Loops)

តាំង ពិន្ទុ = ៨៥

បើ (ពិន្ទុ >= ៩០) {
    បង្ហាញ("និទ្ទេស A - ល្អប្រសើរណាស់!")
} ឬបើ (ពិន្ទុ >= ៨០) {
    បង្ហាញ("និទ្ទេស B - ល្អណាស់!")
} ឬបើ (ពិន្ទុ >= ៧០) {
    បង្ហាញ("និទ្ទេស C - ល្អ")
} ផ្សេងទៀត {
    បង្ហាញ("ត្រូវខិតខំប្រឹងប្រែងបន្ថែមទៀត")
}

បង្ហាញ("--- រង្វិលជុំ ខណៈ (While Loop) ---")
តាំង រាប់ = ១
ខណៈ (រាប់ <= ៥) {
    បង្ហាញ("លេខរាប់:", រាប់)
    រាប់ = រាប់ + ១
}

បង្ហាញ("--- រង្វិលជុំ សម្រាប់ (For Loop) ---")
សម្រាប់ (តាំង i = ១; i <= ៣; i = i + ១) {
    បង្ហាញ("ជុំទី:", i)
}
